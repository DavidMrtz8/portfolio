---
import resource2 from "../assets/svg/resource2.svg?url";
import star from "../assets/svg/star.svg?url";
import next from "../assets/svg/next.svg?url";
import computer from "../assets/svg/computer.svg?url";

const me = "/me.svg"; // Public asset
---

<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-left">
        <div class="hero-tag">Available for new projects</div>
        <h1>
          Backend engineer<br>
          who builds <span class="sr-only">distributed </span>systems<br>
          that <em>don't break</em> <span class="underline">in production.</span>
        </h1>
        <p class="hero-sub">
          I build TypeScript backends for SaaS teams, with a focus on reliable APIs,
          billing workflows, and search integrations.
        </p>
        <div class="hero-cta-row">
          <a href="https://cal.com/davidmrtz/20-min-call" target="_blank" class="btn-primary">Book a free 20-min call →</a>
          <a href="#projects" class="btn-secondary">
            See selected work
          </a>
        </div>
      </div>
      <div class="hero-portrait">
        <div class="hero-portrait-badge">Hola, soy David</div>
          <img
            src={me}
            alt="David Martínez — Backend Engineer"
            width="480"
            height="600"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          >
      </div>
    </div>


    <div class="hero-stats">
      <div class="stat stat-circled">
        <div class="stat-num"><em>Search</em></div>
        <div class="stat-label">Audits and Search Console integrations</div>
      </div>
      <div class="stat">
        <div class="stat-num"><em>Billing</em></div>
        <div class="stat-label">Idempotent payments and usage reconciliation</div>
      </div>
      <div class="stat">
        <div class="stat-num"><em>Async</em></div>
        <div class="stat-label">Event-driven workflows and retries</div>
      </div>
      <div class="stat">
        <div class="stat-num"><em>4+</em></div>
        <div class="stat-label">Years building distributed systems</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero h1 .underline::after {
    content: '';
    position: absolute;
    bottom: -0.18em;
    left: -0.05em;
    right: -0.05em;
    height: 0.36em;
    background: url('../assets/svg/resource2.svg') center/100% 100% no-repeat;
    filter: brightness(0) saturate(100%) invert(45%) sepia(85%) saturate(2000%) hue-rotate(355deg) brightness(95%) contrast(95%);
    z-index: -1;
  }
</style>
