---
import aboutMe from "../assets/svg/about_me.svg?url";
import resource4 from "../assets/svg/resource4.svg?url";
import emailIcon from "../assets/svg/email.svg?url";
import linkedinIcon from "../assets/svg/linkedin.svg?url";
import cvIcon from "../assets/svg/cv.svg?url";
import star from "../assets/svg/star.svg?url";
---

<section class="cta-final" id="contact">
  <div class="contact-banner-wrap">
    <img src={aboutMe} class="doodle contact-banner" alt="Contact me">
  </div>
  
  <div class="container">
    <h2>Got a backend problem<br>worth <em>solving?</em></h2>
    <p>Tell me what you're building. If I'm the right fit, you'll know in our first call. If I'm not, I'll tell you that too.</p>

    <div class="contact-grid">
      <a href="mailto:contact@davidmrtz.me" class="contact-card">
        <div class="contact-card-icon"><img src={emailIcon} alt=""></div>
        <h3>Email</h3>
        <div class="contact-card-meta">contact@davidmrtz.me</div>
        <span class="contact-card-arrow">↗</span>
      </a>
      <a href="https://www.linkedin.com/in/david-daniel-membre%C3%B1o-mart%C3%ADnez-961053322" target="_blank" class="contact-card">
        <div class="contact-card-icon"><img src={linkedinIcon} alt=""></div>
        <h3>LinkedIn</h3>
        <div class="contact-card-meta">/in/davidmrtz</div>
        <span class="contact-card-arrow">↗</span>
      </a>
      <a href="/cv.pdf" download class="contact-card">
        <div class="contact-card-icon"><img src={cvIcon} alt=""></div>
        <h3>CV</h3>
        <div class="contact-card-meta">Download PDF · 2026</div>
        <span class="contact-card-arrow">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .star-mini {
    width: 12px;
    height: 16px;
    background-color: var(--accent);
    -webkit-mask-position: center;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
    display: block;
  }
</style>


