---
// Creative & Compact Orbitron Logo
---

<div class="logo-wrapper">
  <div class="logo-grid font-orbitron">
    <div class="logo-row">
      <span>D</span><span>a</span><span>v</span><span>i</span><span>d</span>
    </div>
    <div class="logo-row second">
      <span>M</span><span>r</span><span>t</span><span>z</span>
    </div>
  </div>
</div>

<style>
  @import "@fontsource-variable/orbitron";

  .logo-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    padding: 4px;
  }

  .logo-grid {
    display: flex;
    flex-direction: column;
    align-items: center; /* Centers rows relative to each other */
    line-height: 0.9;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--ink);
    transition: transform 0.3s ease;
  }

  .logo-row {
    display: flex;
    gap: 2px;
    position: relative;
  }

  .logo-row.second {
    /* No manual margin, let flex center it */
  }

  .logo-grid span {
    transition: all 0.2s ease;
  }

  /* Dot is absolutely positioned to NOT affect centering of the text */
  .dot {
    position: absolute;
    right: -10px;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(232, 99, 42, 0.4);
  }

  .logo-wrapper:hover .logo-grid {
    transform: scale(1.05);
  }

  .logo-row span:hover {
    color: var(--accent);
  }

  @media (min-width: 768px) {
    .logo-grid {
      font-size: 22px;
    }
  }

  /* Hover effects */
  .logo-wrapper:hover .logo-grid {
    transform: scale(1.05);
  }

  .logo-row span:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }

  .logo-grid:hover span:not(:hover) {
    color: var(--ink-muted);
    opacity: 0.6;
  }

  @media (min-width: 768px) {
    .logo-grid {
      font-size: 24px;
    }
    .dot {
      width: 7px;
      height: 7px;
    }
  }
</style>