---
import star from "../assets/svg/star.svg?url";
import folder from "../assets/svg/folder.svg?url";
import resource4 from "../assets/svg/resource4.svg?url";
import resource5 from "../assets/svg/resource5.svg?url";
import resource13 from "../assets/svg/resource13.svg?url";

const projects = [
  {
    case: "01",
    year: "2026",
    title: "Cerebro — External SEO and Search Console",
    context: "Multi-tenant SaaS · Website analytics",
    problem: "Teams needed to audit websites hosted elsewhere and bring search performance and indexing diagnostics into the same workspace.",
    built: "I built external page audits, linked verified Search Console properties, and added URL indexing checks and saved research. Claude discovers competitors and proposes content ideas using cited public evidence.",
    results: [
      { num: "Audits", label: "Technical and indexing checks" },
      { num: "History", label: "Saved findings and research" }
    ],
    stack: ["TypeScript", "Convex", "Google Search Console", "Claude"],
    mockupType: "seo",
    url: "Cerebro · External SEO"
  },
  {
    case: "02",
    year: "2026",
    title: "GraphxSource — Reliable Orders and Billing",
    context: "NestJS backend · Orders and payments",
    problem: "Payment method retries needed a consistent response, billing changes needed to respect subscriber ownership, and weekly quota reconciliation needed to exclude provisional reservations.",
    built: "I implemented replay of the original payment method creation response, enforced subscriber ownership on deletion, corrected weekly quota reconciliation, and improved order idempotency conflict logging.",
    results: [
      { num: "Replay", label: "Original 201 response on retry" },
      { num: "Scoped", label: "Subscriber ownership on deletion" }
    ],
    stack: ["NestJS", "TypeScript", "Idempotency", "Reconciliation"],
    mockupType: "terminal",
    url: "GraphxSource · Billing request flow"
  },
  {
    case: "03",
    year: "2024",
    title: "iOBOT — Omnichannel CRM Backend",
    context: "B2B SaaS · Authcode",
    problem: "Unify WhatsApp, Instagram and Messenger into a single CRM pipeline, real-time, at scale.",
    built: "Event-driven workflows, Socket.io for real-time delivery, and an OpenAI chatbot layer for repetitive flows.",
    results: [
      { num: "3 channels", label: "Unified backend pipeline" },
      { num: "Real-time", label: "Delivery across integrations" }
    ],
    stack: ["Node.js", "Event-driven", "Socket.io", "OpenAI API"],
    mockupType: "chat",
    url: "iOBOT inbox · unified"
  }
];
---

<section class="section" id="projects" style="padding-top: 40px;">
  <div class="container">
    <div class="section-label">
      <span class="label-star" style={`-webkit-mask-image: url(${star}); mask-image: url(${star});`}></span>
      [ 02 ] Selected work
    </div>
    <h2 class="section-title">Selected <em>backend</em> engineering projects.</h2>

    {projects.map((project, index) => (
      <div class={`case-study ${index === 1 ? 'reverse' : ''}`}>
        <div class="case-content">
          <div class="case-meta">
            <div class="case-tag">
              <img src={folder} class="folder-mini" alt="">
              Case {project.case} · {project.year}
            </div>
            <h3 class="case-title">{project.title}</h3>
            <p class="case-context">{project.context}</p>
          </div>
          <div class="case-body">
            <h4>The problem</h4>
            <p>{project.problem}</p>

            <h4>What I built</h4>
            <p>{project.built}</p>

            <div class="results-grid">
              {project.results.map(result => (
                <div>
                  <div class="result-num"><em>{result.num}</em></div>
                  <div class="result-label">{result.label}</div>
                </div>
              ))}
              <img src={index === 0 ? resource4 : (index === 1 ? resource5 : resource13)} class:list={["arrow-deco", { "arrow-deco-chat": index === 2 }]} alt="">
            </div>

            <div class="case-stack">
              {project.stack.map(item => (
                <span class="service-tag">{item}</span>
              ))}
            </div>
          </div>
        </div>
        
        <div class="case-mockup">
          <div class="mockup-bar">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="url">{project.url}</span>
          </div>
          <div class="mockup-body">
            {project.mockupType === 'seo' && (
              <div class="pipe-flow">
                <div class="pipe-col">
                  <div class="pipe-col-label">// collect</div>
                  <div class="pipe-event"><span class="ev-dot"></span>Public pages</div>
                  <div class="pipe-event"><span class="ev-dot"></span>Search data</div>
                  <div class="pipe-event"><span class="ev-dot"></span>Competitors</div>
                </div>
                <div class="pipe-col">
                  <div class="pipe-col-label">// analyze</div>
                  <div class="pipe-event"><span class="ev-dot"></span>Technical audit</div>
                  <div class="pipe-event"><span class="ev-dot"></span>URL inspection</div>
                  <div class="pipe-event"><span class="ev-dot"></span>Claude research</div>
                </div>
                <div class="pipe-col">
                  <div class="pipe-col-label">// review</div>
                  <div class="pipe-event delivered"><span class="ev-dot"></span>✓ History</div>
                  <div class="pipe-event delivered"><span class="ev-dot"></span>✓ Suggested fixes</div>
                  <div class="pipe-event delivered"><span class="ev-dot"></span>✓ Content plan</div>
                </div>
              </div>
            )}
            
            {project.mockupType === 'terminal' && (
              <div class="terminal-content">
                <span class="term-line"><span class="muted">[billing]</span> create payment method → <span class="ok">201</span></span>
                <span class="term-line"><span class="muted">[billing]</span> request retried</span>
                <span class="term-line"><span class="muted">[billing]</span> idempotency key matched</span>
                <span class="term-line"><span class="muted">[billing]</span> original response → <span class="ok">201 replayed</span></span>
                <span class="term-line"><span class="muted">[billing]</span> deletion checked against ownership</span>
                <span class="term-line"><span class="muted">[quota]</span> <span class="ok">usage reconciled</span><span class="term-cursor"></span></span>
              </div>
            )}

            {project.mockupType === 'chat' && (
              <div class="chat-window">
                <div class="chat-msg"><span class="ch-tag">whatsapp</span>Hi! Is my order #4821 still on the way?</div>
                <div class="chat-msg me"><span class="ch-tag">bot</span>Yes — out for delivery, ETA 18:30 📦</div>
                <div class="chat-msg"><span class="ch-tag">instagram</span>Can someone help with billing?</div>
                <div class="chat-msg me"><span class="ch-tag">agent</span>Routing you to a human now…</div>
                <div class="chat-msg"><span class="ch-tag">messenger</span>Thanks, super fast!</div>
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .results-grid .arrow-deco-chat {
    width: 50px;
    bottom: -22px;
    right: -10px;
    transform: rotate(40deg);
  }
  @media (max-width: 900px) {
    .results-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 20px;
    }
    .result-num { font-size: clamp(22px, 7vw, 36px); }
    .results-grid .arrow-deco {
      width: 38px;
      right: 0;
      bottom: -18px;
    }
  }
  .label-star {
    width: 14px;
    height: 18px;
    background-color: var(--accent);
    -webkit-mask-position: center;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
    display: block;
  }
</style>
