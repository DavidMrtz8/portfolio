---
import star from "../assets/svg/star.svg?url";
import folder from "../assets/svg/folder.svg?url";
import resource4 from "../assets/svg/resource4.svg?url";
import resource5 from "../assets/svg/resource5.svg?url";
import resource13 from "../assets/svg/resource13.svg?url";

const projects = [
  {
    case: "01",
    year: "2025",
    title: "Distributed Notification System with the Outbox Pattern",
    context: "Multi-tenant SaaS · GraphxSource",
    problem: "Critical events were being lost in transit. Silent failures, no traceability, customers complaining.",
    built: "Outbox Pattern with async dispatcher, transactional persistence, retries with exponential backoff, and distributed tracing.",
    results: [
      { num: "99.9%", label: "Event delivery reliability" },
      { num: "0", label: "Silent failures in critical flows" }
    ],
    stack: ["NestJS", "PostgreSQL", "AWS SQS", "Outbox Pattern"],
    mockupType: "outbox",
    url: "outbox-dispatcher · live"
  },
  {
    case: "02",
    year: "2025",
    title: "Fault-Tolerant Order Processing",
    context: "High-volume transactional system · GraphxSource",
    problem: "Orders failing on transient errors. Race conditions. Engineers manually reprocessing every week.",
    built: "Retry system with idempotency, partial indexes, pessimistic locking, and server-side billing validation.",
    results: [
      { num: "−40%", label: "Order processing failures" },
      { num: "~0", label: "Duplicate records or corruption" }
    ],
    stack: ["TypeScript", "PostgreSQL", "Idempotency", "Locking"],
    mockupType: "terminal",
    url: "$ node order-worker.ts"
  },
  {
    case: "03",
    year: "2024",
    title: "iOBOT — Omnichannel CRM Backend",
    context: "B2B SaaS · Authcode",
    problem: "Unify WhatsApp, Instagram and Messenger into a single CRM pipeline, real-time, at scale.",
    built: "Event-driven workflows on AWS, Socket.io for real-time, plus an OpenAI chatbot layer for repetitive flows.",
    results: [
      { num: "3 channels", label: "Unified backend pipeline" },
      { num: "Real-time", label: "Delivery across integrations" }
    ],
    stack: ["Node.js", "AWS SQS", "Socket.io", "OpenAI API"],
    mockupType: "chat",
    url: "iOBOT inbox · unified"
  }
];
---

<section class="section" id="projects" style="padding-top: 40px;">
  <div class="container">
    <div class="section-label">
      <span class="label-star" style={`-webkit-mask-image: url(${star}); mask-image: url(${star});`}></span>
      [ 02 ] Selected work
    </div>
    <h2 class="section-title">Problems solved, <em>measured</em> in production.</h2>

    {projects.map((project, index) => (
      <div class={`case-study ${index === 1 ? 'reverse' : ''}`}>
        <div class="case-content">
          <div class="case-meta">
            <div class="case-tag">
              <img src={folder} class="folder-mini" alt="">
              Case {project.case} · {project.year}
            </div>
            <h3 class="case-title">{project.title}</h3>
            <p class="case-context">{project.context}</p>
          </div>
          <div class="case-body">
            <h4>The problem</h4>
            <p>{project.problem}</p>

            <h4>What I built</h4>
            <p>{project.built}</p>

            <div class="results-grid">
              {project.results.map(result => (
                <div>
                  <div class="result-num"><em>{result.num}</em></div>
                  <div class="result-label">{result.label}</div>
                </div>
              ))}
              <img src={index === 0 ? resource4 : (index === 1 ? resource5 : resource13)} class="arrow-deco" alt="" style={index === 2 ? "width: 50px; bottom: -22px; right: -10px; transform: rotate(40deg);" : ""}>
            </div>

            <div class="case-stack">
              {project.stack.map(item => (
                <span class="service-tag">{item}</span>
              ))}
            </div>
          </div>
        </div>
        
        <div class="case-mockup">
          <div class="mockup-bar">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="url">{project.url}</span>
          </div>
          <div class="mockup-body">
            {project.mockupType === 'outbox' && (
              <div class="pipe-flow">
                <div class="pipe-col">
                  <div class="pipe-col-label">// outbox</div>
                  <div class="pipe-event"><span class="ev-dot"></span>order.created</div>
                  <div class="pipe-event"><span class="ev-dot"></span>billing.charged</div>
                  <div class="pipe-event"><span class="ev-dot"></span>user.invited</div>
                </div>
                <div class="pipe-col">
                  <div class="pipe-col-label">// queue</div>
                  <div class="pipe-event"><span class="ev-dot"></span>SQS → retry</div>
                  <div class="pipe-event"><span class="ev-dot"></span>SQS → ack</div>
                  <div class="pipe-event"><span class="ev-dot"></span>SQS → ack</div>
                </div>
                <div class="pipe-col">
                  <div class="pipe-col-label">// delivered</div>
                  <div class="pipe-event delivered"><span class="ev-dot"></span>✓ webhook</div>
                  <div class="pipe-event delivered"><span class="ev-dot"></span>✓ stripe</div>
                  <div class="pipe-event delivered"><span class="ev-dot"></span>✓ sendgrid</div>
                </div>
              </div>
            )}
            
            {project.mockupType === 'terminal' && (
              <div class="terminal-content">
                <span class="term-line"><span class="muted">[10:42:01]</span> → order #4821 received</span>
                <span class="term-line"><span class="muted">[10:42:01]</span> lock acquired · <span class="ok">FOR UPDATE</span></span>
                <span class="term-line"><span class="muted">[10:42:01]</span> billing.validate → <span class="warn">timeout</span></span>
                <span class="term-line"><span class="muted">[10:42:02]</span> retry 1/3 · backoff 200ms</span>
                <span class="term-line"><span class="muted">[10:42:02]</span> billing.validate → <span class="ok">200 OK</span></span>
                <span class="term-line"><span class="muted">[10:42:02]</span> idempotency_key matched · skip dup</span>
                <span class="term-line"><span class="muted">[10:42:02]</span> persist → <span class="ok">order.confirmed</span></span>
                <span class="term-line"><span class="muted">[10:42:02]</span> emit → outbox · webhook queued</span>
                <span class="term-line"><span class="muted">[10:42:02]</span> <span class="ok">✓ done</span> · 124ms</span>
                <span class="term-line"><span class="muted">[10:42:03]</span> ready for next job<span class="term-cursor"></span></span>
              </div>
            )}

            {project.mockupType === 'chat' && (
              <div class="chat-window">
                <div class="chat-msg"><span class="ch-tag">whatsapp</span>Hi! Is my order #4821 still on the way?</div>
                <div class="chat-msg me"><span class="ch-tag">bot</span>Yes — out for delivery, ETA 18:30 📦</div>
                <div class="chat-msg"><span class="ch-tag">instagram</span>Can someone help with billing?</div>
                <div class="chat-msg me"><span class="ch-tag">agent</span>Routing you to a human now…</div>
                <div class="chat-msg"><span class="ch-tag">messenger</span>Thanks, super fast!</div>
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .label-star {
    width: 14px;
    height: 18px;
    background-color: var(--accent);
    -webkit-mask-position: center;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
    display: block;
  }
</style>
