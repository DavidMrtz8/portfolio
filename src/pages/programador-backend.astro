---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Services from "../components/Services.astro";
import Footer from "../components/Footer.astro";
import star from "../assets/svg/star.svg?url";

const title = "Programador backend freelance | David Martínez";
const description = "Programador backend freelance para equipos SaaS. Desarrollo APIs con NestJS y TypeScript, integro pagos y diagnostico fallos en producción. Trabajo remoto en español e inglés.";

const projects = [
  {
    title: "Cerebro",
    context: "Auditorías web e integración con Google",
    description: "Implementé auditorías para sitios externos, métricas de Google Search Console e inspección de URLs. Los equipos pueden guardar hallazgos y convertirlos en cambios concretos para su sitio.",
    stack: ["TypeScript", "Convex", "Google Search Console"],
  },
  {
    title: "GraphxSource",
    context: "Pagos y facturación",
    description: "Implementé la repetición de la respuesta original al reintentar el alta de un método de pago, validé la titularidad antes de borrar métodos y corregí la conciliación semanal de consumo.",
    stack: ["NestJS", "TypeScript", "Idempotencia"],
  },
];
---

<Layout title={title} description={description} language="es" keywords="">
  <Header language="es" />
  <Services language="es" />

  <section id="projects" class="section">
    <div class="container">
      <div class="section-label">
        <span class="section-star" style={`--star-image: url(${star})`}></span>
        [ 02 ] Proyectos
      </div>
      <h2 class="section-title">Backends que ya <em>construí.</em></h2>
      <div class="services-grid">
        {projects.map(({ title, context, description, stack }) => (
          <article class="service">
            <p class="service-num">{context}</p>
            <h3 class="service-title">{title}</h3>
            <p class="service-desc">{description}</p>
            <div class="service-tags">
              {stack.map((label) => <span class="service-tag">{label}</span>)}
            </div>
          </article>
        ))}
      </div>
      <a href="/#projects" class="btn-secondary related-work">Ver los casos de estudio en inglés →</a>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="container">
      <div class="section-label">[ 03 ] Contacto</div>
      <h2 class="section-title">Cuéntame qué necesitas <em>resolver.</em></h2>
      <p class="contact-copy">En la primera llamada revisamos tu backend, el problema que quieres resolver y cómo comprobar que el cambio funciona.</p>
      <div class="hero-cta-row">
        <a href="https://cal.com/davidmrtz/20-min-call" class="btn-primary">Agenda una llamada →</a>
        <a href="mailto:contact@davidmrtz.me" class="btn-secondary">Escríbeme por correo</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  #projects .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 900px) { #projects .services-grid { grid-template-columns: 1fr; } }
  .section-star {
    width: 14px;
    height: 18px;
    background: var(--accent);
    mask: var(--star-image) center / contain no-repeat;
  }
  .related-work { display: inline-block; margin-top: 24px; }
  .contact-copy { max-width: 58ch; margin-bottom: 24px; }
</style>
